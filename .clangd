# clangd config for open5gs (5GC — C, GNU11).
#
# Compilation database generated by meson inside Docker:
#   ./gen-compile-commands.sh open5gs
# (runs: docker run open5gs-5gc-zmq-tsn:local meson setup build --reconfigure)

CompileFlags:
  CompilationDatabase: build

  Add:
    - -Wno-unused-parameter
    - -Wno-missing-field-initializers
  Remove:
    - -march=native

Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes

Hover:
  ShowAKA: Yes
